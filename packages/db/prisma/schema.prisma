// Esquema de datos (doc 09). Lo que Prisma no expresa (extensiones, CHECK,
// triggers) va como SQL manual dentro de la migración.
// Índices parciales: preview partialIndexes (ADR-0016). El predicado va en la
// forma normalizada de Postgres (`= ANY (ARRAY[...])`, no `IN`) o db:check da drift.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  COMPRADOR
  ORGANIZADOR
  VALIDADOR
  ADMIN

  @@map("rol")
}

model Usuario {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // citext: Ana@x.com y ana@x.com son el mismo email para el UNIQUE.
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  nombre       String
  // Opcional (minimización de datos). CHECK +591 en la migración.
  telefono     String?
  rol          Rol      @default(COMPRADOR)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  eventosOrganizados Evento[]          @relation("EventoOrganizador")
  eventosAsignados   EventoValidador[]

  @@map("usuarios")
}

// ─── Geografía (ADR-0014) ────────────────────────────────────────────────────
// Expandir a otro departamento = insertar filas, sin cambios de código (RNF-14).

model Departamento {
  id       Int      @id @default(autoincrement()) @db.SmallInt
  // CB LP SC OR PT CH TJ BE PD
  codigo   String   @unique @db.Char(2)
  nombre   String   @unique
  ciudades Ciudad[]

  @@map("departamentos")
}

model Ciudad {
  id             Int          @id @default(autoincrement())
  departamentoId Int          @map("departamento_id") @db.SmallInt
  nombre         String
  // Filtro ?ciudad=<slug> (doc 09 §3).
  slug           String       @unique
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  recintos       Recinto[]

  @@map("ciudades")
}

model Recinto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ciudadId  Int      @map("ciudad_id")
  nombre    String
  direccion String
  ciudad    Ciudad   @relation(fields: [ciudadId], references: [id], onDelete: Restrict)
  eventos   Evento[]

  // Listado por ciudad (doc 09 §5).
  @@index([ciudadId])
  @@map("recintos")
}

// ─── Eventos ─────────────────────────────────────────────────────────────────
// Estados como text + CHECK en la migración (doc 09 §1), no enums: el SQL
// explícito de ADR-0013 los compara sin casts.

model Evento {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizadorId String   @map("organizador_id") @db.Uuid
  recintoId     String   @map("recinto_id") @db.Uuid
  titulo        String
  // UTC. Se muestran en America/La_Paz.
  inicio        DateTime @db.Timestamptz(6)
  ventaInicio   DateTime @map("venta_inicio") @db.Timestamptz(6)
  // BORRADOR PUBLICADO CANCELADO FINALIZADO
  estado        String   @default("BORRADOR")
  mapaVersion   BigInt   @default(0) @map("mapa_version")

  organizador Usuario           @relation("EventoOrganizador", fields: [organizadorId], references: [id], onDelete: Restrict)
  recinto     Recinto           @relation(fields: [recintoId], references: [id], onDelete: Restrict)
  zonas       Zona[]
  validadores EventoValidador[]

  // Listado por ciudad (doc 09 §5).
  @@index([estado, inicio])
  @@map("eventos")
}

model Zona {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId       String @map("evento_id") @db.Uuid
  // Platea, General
  nombre         String
  // Centavos de BOB (ADR-0010). CHECK >= 0 en la migración.
  precioCentavos BigInt @map("precio_centavos")
  moneda         String @default("BOB") @db.Char(3)

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Restrict)

  @@map("zonas")
}

model EventoValidador {
  eventoId  String @map("evento_id") @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([eventoId, usuarioId])
  @@map("evento_validadores")
}
