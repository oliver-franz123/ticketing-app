// Esquema de datos (doc 09). Lo que Prisma no expresa (extensiones, CHECK,
// triggers) va como SQL manual dentro de la migración.
// Índices parciales: preview partialIndexes (ADR-0016). El predicado va en la
// forma normalizada de Postgres (`= ANY (ARRAY[...])`, no `IN`) o db:check da drift.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  COMPRADOR
  ORGANIZADOR
  VALIDADOR
  ADMIN

  @@map("rol")
}

model Usuario {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // citext: Ana@x.com y ana@x.com son el mismo email para el UNIQUE.
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  nombre       String
  // Opcional (minimización de datos). CHECK +591 en la migración.
  telefono     String?
  rol          Rol      @default(COMPRADOR)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("usuarios")
}

// ─── Geografía (ADR-0014) ────────────────────────────────────────────────────
// Expandir a otro departamento = insertar filas, sin cambios de código (RNF-14).

model Departamento {
  id       Int      @id @default(autoincrement()) @db.SmallInt
  // CB LP SC OR PT CH TJ BE PD
  codigo   String   @unique @db.Char(2)
  nombre   String   @unique
  ciudades Ciudad[]

  @@map("departamentos")
}

model Ciudad {
  id             Int          @id @default(autoincrement())
  departamentoId Int          @map("departamento_id") @db.SmallInt
  nombre         String
  // Filtro ?ciudad=<slug> (doc 09 §3).
  slug           String       @unique
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  recintos       Recinto[]

  @@map("ciudades")
}

model Recinto {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ciudadId  Int    @map("ciudad_id")
  nombre    String
  direccion String
  ciudad    Ciudad @relation(fields: [ciudadId], references: [id], onDelete: Restrict)

  // Listado por ciudad (doc 09 §5).
  @@index([ciudadId])
  @@map("recintos")
}
