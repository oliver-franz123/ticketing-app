{
  "name": "@entradas/db",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema Prisma, migraciones y cliente generado, compartidos entre api y worker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "seed": "npm run build && node prisma/semillas/seed.mts",
    "test": "vitest run test/*.spec.ts",
    "test:e2e": "vitest run test/*.e2e-spec.ts"
  },
  "devDependencies": {
    "argon2": "^0.45.1",
    "dotenv": "18.0.8",
    "prisma": "7.10.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  }
}
