# Copiar a .env (no se versiona):  cp .env.example .env
# Lo leen la API, el Worker y docker compose. Referencia completa: docs/07-despliegue.md §6.
# Los secretos van vacíos: generarlos en local con  openssl rand -base64 32

# --- General ---
NODE_ENV=development
TZ=UTC
TZ_DISPLAY=America/La_Paz
# api | worker (mismo build, distinto arranque)
APP_ROLE=api
PORT=3000

# --- Infraestructura local (docker compose) ---
POSTGRES_USER=entradas
POSTGRES_PASSWORD=entradas
POSTGRES_DB=entradas
DATABASE_URL=postgresql://entradas:entradas@localhost:5432/entradas
# En local es la misma base. En Supabase: pooler en modo sesión (:5432) para migraciones.
DIRECT_URL=postgresql://entradas:entradas@localhost:5432/entradas
REDIS_URL=redis://localhost:6379
# Mailpit: los emails se ven en http://localhost:8025
SMTP_URL=smtp://localhost:1025

# --- Auth (T9) ---
# openssl rand -base64 32 (mínimo 32 bytes: la API no arranca con menos)
JWT_SECRET=
JWT_EXPIRES_IN=60m

# --- QR firmado con Ed25519 (semana 4) ---
# La clave privada solo la usa el Worker. La pública, la API.
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_PUBLIC_KEY=

# --- Pagos (ADR-0015) ---
PAYMENT_PROVIDERS=simulador
PAYMENT_PROVIDER_DEFAULT=simulador
SIMULADOR_HABILITADO=true
API_PUBLIC_URL=http://localhost:3000
SIMULADOR_WEBHOOK_SECRET=
# Opcional: solo si se pudo abrir la cuenta de test (T11). Nunca sk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# Vacío en local: se usa Mailpit. Resend solo en el entorno desplegado.
RESEND_API_KEY=
EMAIL_FROM=Entradas <entradas@localhost>

# --- Reservas y límites ---
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_RESERVAS_IP=30
RESERVA_TTL_SEGUNDOS=300
