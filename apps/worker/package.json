{
  "name": "@entradas/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker NestJS sin HTTP: consume el outbox (QR, PDF, email) (ADR-0017)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "claves:qr": "node scripts/generar-claves-qr.mjs"
  },
  "dependencies": {
    "@entradas/db": "*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2"
  }
}
